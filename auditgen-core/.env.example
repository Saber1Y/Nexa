# Nexa Frontend Mainnet Environment Variables
# Copy this to .env.mainnet.local (gitignored) for `npm run dev:mainnet`.

# The URL of your Nexa API Bridge (direct on-chain payment verifier).
#
# Leave UNSET in production: the app then calls /api on its own origin,
# which is how the Vercel deployment routes to the serverless bridge.
#
# Local development: set it to the bridge started on port 3403.
VITE_API_BASE_URL=http://localhost:3403
# Legacy alias - VITE_API_BASE_URL takes precedence when both are set
VITE_API_URL=http://localhost:3403

# Direct payment gateway.
# Mainnet defaults. Use `npm run dev:testnet` with .env.testnet.local for Bohr.
VITE_BOT_CHAIN_ID=677
VITE_BOT_RPC_URL=https://rpc.botchain.ai
VITE_BOT_EXPLORER_URL=https://scan.botchain.ai
VITE_BOT_USDT_ADDRESS=0xaBabc7Ddc03e501d190C676BF3d92ef0e6e87a3C
VITE_NEXA_GATEWAY_ADDRESS=0x2f085838eef6255d527db447e188545da47683b9
VITE_NEXA_SERVICE_REGISTRY_ADDRESS=0x4d5845487a11491575aFE5E63554E45D3b553f51
VITE_NEXA_RECEIPT_REGISTRY_ADDRESS=0x4a29F92A5Bf3F1e242a8bcdc5F7009e67395c5B1
# Optional overrides when using a non-default BOT Chain endpoint.
