# Nexa Frontend Environment Variables
# Copy this to .env (not committed) and set the values

# The URL of your Nexa API Bridge (x402 audit service).
#
# Leave UNSET in production: the app then calls /api on its own origin,
# which is how the Vercel deployment routes to the serverless bridge.
#
# Local development: set it to the bridge started with `npm start`.
VITE_API_BASE_URL=http://localhost:3402
# Legacy alias - VITE_API_BASE_URL takes precedence when both are set
VITE_API_URL=http://localhost:3402
