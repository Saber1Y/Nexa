# ─── Legacy GenLayer/Stellar compatibility ───
# GenLayer is still used by the first audit adapter. Stellar variables are not read by
# the BOT runtime and are retained only for migration notes/legacy scripts.
GENLAYER_PRIVATE_KEY=0x...
GENLAYER_ADDRESS=0x...
STELLAR_SECRET_KEY=legacy_only
STELLAR_PUBLIC_KEY=legacy_only

# ─── GenLayer ───
