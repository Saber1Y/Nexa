# ─── BOT Chain Mainnet ───
BOT_RPC_URL=https://rpc.botchain.ai
BOT_CHAIN_ID=677
BOT_EXPLORER_URL=https://scan.botchain.ai
BOT_USDT_ADDRESS=0xaBabc7Ddc03e501d190C676BF3d92ef0e6e87a3C
NEXA_GATEWAY_ADDRESS=0x2f085838eef6255d527db447e188545da47683b9

# ─── Service ───
# Fee recipient for service payments.
NEXA_PAY_TO_ADDRESS=0x772c86be44eAF536df1B5f8924417acCC6bB4028
# Service registered in NexaServiceRegistry.
NEXA_SERVICE_ID=resume-intelligence-v1
NEXA_SERVICE_REGISTRY_ADDRESS=0x4d5845487a11491575aFE5E63554E45D3b553f51
NEXA_RECEIPT_REGISTRY_ADDRESS=0x4a29F92A5Bf3F1e242a8bcdc5F7009e67395c5B1
# Price in atomic USDT (6 decimals): 100000 = 0.10 USDT.
NEXA_AUDIT_PRICE_ATOMIC=100000
# AI adapter: llm (Google Gemini API) or genlayer (optional, requires a deployed contract).
NEXA_AI_ADAPTER=llm

# Gemini native inference API. This is separate from BOT Chain payment settlement.
# No per-request blockchain payment is made by this adapter.
NEXA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
NEXA_LLM_MODEL=gemini-3.8-flash
NEXA_LLM_API_KEY=your_gemini_api_key

# ─── Server keys (never commit real values) ───
# Writes receipts to NexaReceiptRegistry (0x-prefixed 32-byte key, must own registry).
NEXA_RECEIPT_SIGNER_PRIVATE_KEY=0x...
NEXA_RECEIPT_REGISTRY_START_BLOCK=25875770

# ─── GenLayer adapter (preserved, requires deployed contract + key) ───
GENLAYER_PRIVATE_KEY=0x...
GENLAYER_ADDRESS=0x...
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CONTRACT_ADDRESS=0x9CE0d2626753e4C7729C70feeB41eAaB8Ecc189b

# ─── Server ───
PORT=3403

# ─── Local BOT Chain testnet override ───
# Set these in the shell when running the API against Bohr; do not mix testnet
# and mainnet addresses in the same process.
# BOT_CHAIN_ID=968
# BOT_RPC_URL=https://rpc.bohr.life
# BOT_EXPLORER_URL=https://scan.bohr.life
# BOT_USDT_ADDRESS=0x75edC9335175Fc0552D51D48439F229c10420fe3
# NEXA_SERVICE_REGISTRY_ADDRESS=0x6A2C234080Da1329b0418E4d5Dc34b2004D464bF
# NEXA_RECEIPT_REGISTRY_ADDRESS=0xC37C0a8988BB174f2a9b199b8B8f0Fb51f5c848D
# NEXA_PAY_TO_ADDRESS=0x3F5b96A494061F7338Da529e3047809Ac6a7FB84
# NEXA_GATEWAY_ADDRESS=<testnet gateway deployment>
