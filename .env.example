# ─── BOT Chain Bohr Testnet ───
BOT_RPC_URL=https://rpc.bohr.life
BOT_CHAIN_ID=968
BOT_EXPLORER_URL=https://scan.bohr.life
BOT_USDT_ADDRESS=0x75edC9335175Fc0552D51D48439F229c10420fe3
BOT_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
BOT_EXACT_PERMIT2_PROXY=0x402085c248EeA27D92E8b30b2C58ed07f9E20001

# ─── Service ───
# Fee recipient for service payments.
NEXA_PAY_TO_ADDRESS=your_provider_wallet
# Service registered in NexaServiceRegistry.
NEXA_SERVICE_ID=resume-intelligence-v1
NEXA_SERVICE_REGISTRY_ADDRESS=0x6A2C234080Da1329b0418E4d5Dc34b2004D464bF
NEXA_RECEIPT_REGISTRY_ADDRESS=0xC37C0a8988BB174f2a9b199b8B8f0Fb51f5c848D
# Price in atomic tUSDT (6 decimals): 100000 = 0.10 tUSDT.
NEXA_AUDIT_PRICE_ATOMIC=100000
# AI adapter: llm (default, paid upstream call) or genlayer (preserved, not operational).
NEXA_AI_ADAPTER=llm

# ─── Server keys (never commit real values) ───
# Pays settlement gas on BOT Chain (0x-prefixed 32-byte key).
NEXA_FACILITATOR_PRIVATE_KEY=0x...
# Writes receipts to NexaReceiptRegistry (0x-prefixed 32-byte key, must own registry).
NEXA_RECEIPT_SIGNER_PRIVATE_KEY=0x...

# ─── Upstream paid LLM (x402 client, EIP-3009 on Base) ───
NEXA_UPSTREAM_LLM_URL=https://agentdata-api.sander-van-aard.workers.dev/llm/chat
# Base wallet key holding USDC for upstream calls.
NEXA_UPSTREAM_PRIVATE_KEY=0x...

# ─── GenLayer adapter (preserved, requires deployed contract + key) ───
GENLAYER_PRIVATE_KEY=0x...
GENLAYER_ADDRESS=0x...
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CONTRACT_ADDRESS=0x9CE0d2626753e4C7729C70feeB41eAaB8Ecc189b

# ─── Server ───
PORT=3402
